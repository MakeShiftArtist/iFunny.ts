{
    "name": "ifunny.ts",
    "version": "0.9.0",
    "description": "An iFunny API wrapper written in TypeScript",
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src"
    ],
    "sideEffects": false,
    "scripts": {
        "test": "tsc --noEmit -p tsconfig.cjs.json && tsc --noEmit -p tsconfig.esm.json",
        "test:exports": "node scripts/check-exports.cjs",
        "clean": "rm -rf ./dist",
        "build": "npm run build:cjs && npm run build:esm && node scripts/write-dist-pkg.cjs",
        "build:cjs": "tsc -p tsconfig.cjs.json",
        "build:esm": "tsc -p tsconfig.esm.json",
        "rebuild": "npm run clean && npm run build",
        "lint": "eslint .",
        "lint:fix": "npm run lint -- --fix",
        "fmt": "prettier . --check",
        "fmt:fix": "prettier . --write",
        "changelog": "auto-changelog -p && git add CHANGELOG.md",
        "update": "npx npm-check-updates -u && npm install",
        "link": "npm run rebuild && npm link",
        "version": "npm run changelog",
        "push": "npm run rebuild && git push && npm publish",
        "prepack": "npm run rebuild",
        "docs": "typedoc",
        "docs:clean": "rm -rf ./docs",
        "docs:publish": "npm run docs:clean && npm run docs && gh-pages -d ./docs/ -t true",
        "login": "npx ts-node login.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MakeShiftArtist/ifunny.ts"
    },
    "keywords": [
        "ifunny",
        "typescript",
        "api",
        "library",
        "ifunny.co"
    ],
    "author": "MakeShiftArtist <makeshiftdevelopment+npm@proton.me> (https://github.com/makeshiftartist)",
    "license": "CC0-1.0",
    "bugs": {
        "url": "https://github.com/MakeShiftArtist/iFunny.ts/issues"
    },
    "homepage": "https://github.com/MakeShiftArtist/iFunny.ts#readme",
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@eslint/json": "^0.14.0",
        "@types/node": "25.0.2",
        "@types/readline-sync": "^1.4.8",
        "auto-changelog": "^2.7.0",
        "eslint": "^9.39.5",
        "gh-pages": "6.3.0",
        "globals": "^16.5.0",
        "jiti": "^2.6.1",
        "prettier": "^3.9.10",
        "readline-sync": "^1.4.10",
        "ts-node": "10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "dependencies": {
        "@ifunny/ifunny-api-types": "^1.3.0",
        "axios": "1.20.0",
        "eventemitter3": "5.0.1",
        "form-data": "^4.0.6",
        "node-ts-cache": "^4.4.0",
        "node-ts-cache-storage-memory": "^4.4.0"
    }
}
