{
    "compileOnSave": true,
    "compilerOptions": {
        "strict": true,
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["node"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "moduleDetection": "force",
        "sourceMap": true,
        "removeComments": false,
        "rootDir": "./src",
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": false,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts"]
}
